# Copy to .env and replace every placeholder before running Docker Compose.
MYSQL_DATABASE=pc_mall
MYSQL_USER=pcmall_app
MYSQL_PASSWORD=replace_with_a_long_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_root_password
# Base64-encoded random value with at least 32 bytes after decoding.
JWT_SECRET_BASE64=replace_with_a_base64_encoded_32_byte_or_longer_secret
# Created only when this username does not exist. Never commit a filled-in .env file.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_initial_admin_password
